  "info": {
    "_postman_id": "75d28591-be08-4862-9676-38d98c4221cf",
    "name": "medRxiv REST Details Usage API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "REST API providing programmatic access to preprint metadata, publication information, and usage statistics for health science research papers posted to medRxiv. Supports retrieval by date range, DOI lookup, and pagination through result sets. Returns metadata including title, authors, abstract, DOI, license, and subject category. The same API also supports bioRxiv preprints via the server parameter.\n\n\nContact Support:\n Name: medRxiv Support",
      "type": "text/plain"
    }
  }
