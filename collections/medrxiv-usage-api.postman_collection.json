          "name": "Retrieve usage statistics",
          "request": {
            "name": "Retrieve usage statistics",
            "description": {
              "content": "Returns usage statistics (abstract views, full-text views, PDF downloads) for preprints in aggregate for the specified server and time interval.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "usage",
                ":interval",
                ":server",
                ":format"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "interval",
                  "description": "(Required) Time interval for statistics. Use 'm' for monthly or 'y' for yearly.\n"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "server",
                  "description": "(Required) The preprint server ('medrxiv' or 'biorxiv')."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "format",
                  "description": "(Required) Response format ('json' or 'xml')."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
